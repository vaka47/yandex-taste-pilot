www.nitca.ru {
  redir https://nitca.ru{uri} permanent
}

nitca.ru {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  reverse_proxy web:3000 {
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
  }

  log {
    output stdout
    format console
  }
}

