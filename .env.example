# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace_with_at_least_32_random_bytes
TOKEN_ENCRYPTION_KEY=replace_with_32_random_bytes_base64_or_64_hex_chars
CRON_SECRET=replace_with_a_random_value

# Official Yandex ID OAuth — fan and portal identity only
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
YANDEX_ID_REDIRECT_URI=http://localhost:3000/auth/yandex/callback
# Exactly one numeric Yandex profile ID: the sole owner of /admin.
ADMIN_YANDEX_IDS=
# Separate owner gate for /admin. Store only a scrypt hash, never the plaintext password.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD_HASH=

# Server-to-server experimental music connector
MUSIC_CONNECTOR_INTERNAL_URL=http://localhost:8000
MUSIC_CONNECTOR_INTERNAL_SECRET=replace_with_a_random_value
MUSIC_CONNECTOR_ENABLED=false
PLAYLIST_SYNC_ENABLED=false

# Dedicated service account only. Prefer the encrypted variant.
SERVICE_YANDEX_MUSIC_TOKEN_ENCRYPTED=
SERVICE_YANDEX_MUSIC_TOKEN=

# Public pilot switches
PUBLIC_FOLLOWER_COUNTS_ENABLED=true
SHOW_ON_REPEAT_ENABLED=true
SHOW_NEW_DISCOVERIES_ENABLED=true
AUTH_TELEGRAM_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
SEED_PILOT_FIXTURES=true
