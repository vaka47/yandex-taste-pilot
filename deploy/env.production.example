NEXT_PUBLIC_APP_URL=https://nitca.ru
DATABASE_URL=postgresql://taste:replace_with_url_safe_password@db:5432/taste?sslmode=disable
DATABASE_SSL=false
POSTGRES_DATABASE=taste
POSTGRES_USER=taste
POSTGRES_PASSWORD=replace_with_url_safe_password

SESSION_SECRET=replace_with_at_least_32_random_bytes
TOKEN_ENCRYPTION_KEY=keep_the_existing_production_value_during_migration
CRON_SECRET=replace_with_a_random_value

YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
YANDEX_ID_REDIRECT_URI=https://nitca.ru/auth/yandex/callback
ADMIN_YANDEX_IDS=
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD_HASH=

MUSIC_CONNECTOR_INTERNAL_URL=http://connector:8000
MUSIC_CONNECTOR_INTERNAL_SECRET=replace_with_a_random_value
MUSIC_CONNECTOR_ENABLED=true
PLAYLIST_SYNC_ENABLED=true
INTERNAL_SECRET=replace_with_the_same_internal_secret

PUBLIC_FOLLOWER_COUNTS_ENABLED=true
SHOW_ON_REPEAT_ENABLED=true
SHOW_NEW_DISCOVERIES_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=followtaste_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_RELAY_URL=https://yandex-taste-pilot.vercel.app/api/telegram/relay
# Only the Vercel deployment needs this. Telegram updates are then forwarded
# to the live Yandex Cloud app without touching the rollback database.
TELEGRAM_WEBHOOK_FORWARD_URL=https://nitca.ru/api/telegram/webhook
# Optional dedicated relay secret. When omitted, TELEGRAM_WEBHOOK_SECRET is used.
TELEGRAM_RELAY_SECRET=
SEED_PILOT_FIXTURES=false

# Keep seven daily verified dumps locally. In Yandex Cloud production the VM
# service account uploads a second copy to a private bucket without static keys.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
BACKUP_ENCRYPTION_KEY=
