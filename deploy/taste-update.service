[Unit]
Description=Deploy the latest verified Taste main branch
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tasteops
Group=tasteops
WorkingDirectory=/opt/taste
ExecStart=/usr/bin/flock -n /var/lock/taste-deploy.lock /opt/taste/deploy/update.sh
Nice=10
IOSchedulingClass=idle

